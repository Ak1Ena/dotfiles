#!/bin/sh
# Block any commit that contains a secret.
PATH="/opt/homebrew/bin:$PATH"
command -v gitleaks >/dev/null || { echo "pre-commit: gitleaks not installed (brew install gitleaks)" >&2; exit 1; }
gitleaks git --pre-commit --staged --redact --no-banner -v || {
  echo "pre-commit: secret found in staged files. Move it to an untracked file (e.g. ~/.zshrc.secrets)." >&2
  exit 1
}
