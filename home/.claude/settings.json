{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ANTHROPIC_BASE_URL": "https://api.anthropic.com",
    "ENABLE_TOOL_SEARCH": "true",
    "HTTPS_PROXY": "http://127.0.0.1:8788",
    "NO_PROXY": "localhost,127.0.0.1",
    "NODE_EXTRA_CA_CERTS": "/Users/m129/.mitmproxy/mitmproxy-ca-cert.pem",
    "PONYTAIL_MAP": "0",
    "MAX_MCP_OUTPUT_TOKENS": "10000"
  },
  "permissions": {
    "allow": [
      "Bash(rm -f ~/.ssh/id_ecdsa_sk_rk ~/.ssh/id_ecdsa_sk_rk.pub ~/.ssh/config)",
      "Bash(rm -rf ~/.ssh/sockets)",
      "Bash(git --version)",
      "Bash(defaults read:*)",
      "Bash(head:*)",
      "Bash(~/.claude/bin/ro *)",
      "Bash(/Users/m129/.claude/bin/ro *)"
    ],
    "deny": [
      "Edit(~/.claude/hooks/readonly-infra.sh)",
      "Edit(~/.claude/bin/ro)",
      "Bash(argocd account *)",
      "Bash(argocd admin *)",
      "Bash(argocd app actions run*)",
      "Bash(argocd app create*)",
      "Bash(argocd app delete*)",
      "Bash(argocd app delete-resource*)",
      "Bash(argocd app edit*)",
      "Bash(argocd app patch*)",
      "Bash(argocd app patch-resource*)",
      "Bash(argocd app rollback*)",
      "Bash(argocd app set*)",
      "Bash(argocd app sync*)",
      "Bash(argocd app terminate-op*)",
      "Bash(argocd app unset*)",
      "Bash(argocd appset *)",
      "Bash(argocd cert *)",
      "Bash(argocd cluster *)",
      "Bash(argocd gpg *)",
      "Bash(argocd proj *)",
      "Bash(argocd repo *)",
      "Bash(argocd repocreds *)",
      "Bash(curl *--data*tenant-config*)",
      "Bash(curl *--request*tenant-config*)",
      "Bash(curl *-F *tenant-config*)",
      "Bash(curl *-X DELETE*tenant-config*)",
      "Bash(curl *-X PATCH*tenant-config*)",
      "Bash(curl *-X POST*tenant-config*)",
      "Bash(curl *-X PUT*tenant-config*)",
      "Bash(curl *-d *tenant-config*)",
      "Bash(curl *tenant-config*--data*)",
      "Bash(curl *tenant-config*--request*)",
      "Bash(curl *tenant-config*-F *)",
      "Bash(curl *tenant-config*-X *)",
      "Bash(curl *tenant-config*-d *)",
      "Bash(kubectl annotate*)",
      "Bash(kubectl apply*)",
      "Bash(kubectl attach*)",
      "Bash(kubectl autoscale*)",
      "Bash(kubectl cordon*)",
      "Bash(kubectl cp*)",
      "Bash(kubectl create*)",
      "Bash(kubectl debug*)",
      "Bash(kubectl delete*)",
      "Bash(kubectl describe secret*)",
      "Bash(kubectl describe secrets*)",
      "Bash(kubectl drain*)",
      "Bash(kubectl edit*)",
      "Bash(kubectl exec*)",
      "Bash(kubectl expose*)",
      "Bash(kubectl get secret*)",
      "Bash(kubectl get secrets*)",
      "Bash(kubectl label*)",
      "Bash(kubectl patch*)",
      "Bash(kubectl replace*)",
      "Bash(kubectl rollout*)",
      "Bash(kubectl run*)",
      "Bash(kubectl scale*)",
      "Bash(kubectl set*)",
      "Bash(kubectl taint*)",
      "Bash(kubectl uncordon*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git -C * push:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr ready:*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/m129/.pixel-agents/hooks/claude-hook.js\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/pr-changes-requested.sh",
            "timeout": 15,
            "statusMessage": "Checking PRs for requested changes..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/session-mode.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/remote-ensure.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/m129/.local/bin/headroom init hook ensure --profile init-user --marker headroom-init-claude",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/ledger.sh",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/qc-gate.sh baseline"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/m129/.pixel-agents/hooks/claude-hook.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/m129/.pixel-agents/hooks/claude-hook.js\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/qc-gate.sh gate"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/m129/.pixel-agents/hooks/claude-hook.js\"",
            "timeout": 330
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/m129/.pixel-agents/hooks/claude-hook.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/m129/.pixel-agents/hooks/claude-hook.js\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "curl -sf -m 0.3 http://127.0.0.1:8787/readyz >/dev/null || /Users/m129/.local/bin/headroom init hook ensure --profile init-user --marker headroom-init-claude",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/m129/.claude/hooks/readonly-infra.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/qc-gate.sh track"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/m129/.pixel-agents/hooks/claude-hook.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/m129/.pixel-agents/hooks/claude-hook.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/m129/.pixel-agents/hooks/claude-hook.js\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/ledger.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/m129/.pixel-agents/hooks/claude-hook.js\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/qc-gate.sh mark"
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/m129/.pixel-agents/hooks/claude-hook.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/m129/.pixel-agents/hooks/claude-hook.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I /Users/m129/.claude/hooks/egm-detect.py",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I /Users/m129/.claude/hooks/correction-reflect.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "bashOutputMaxChars": 12000,
  "statusLine": {
    "type": "command",
    "command": "bash /Users/m129/.claude/statusline-with-agents.sh"
  },
  "enabledPlugins": {
    "warp@claude-code-warp": true,
