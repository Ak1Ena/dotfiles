  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium",
      "autoCompactWindow": 400000
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    },
    "claude-fable-5": {
      "effortLevel": "high"
    }
